#!/bin/sh

set -e

rm -rf tests/outputs
mkdir -p tests/outputs

expected=$(mktemp)
expected_err=$(mktemp)
actual=$(mktemp)
actual_err=$(mktemp)

for arg in "$@"; do
	case "$arg" in
		verbose) verbose=1 ;;
		non-rt) non_rt=1 ;;
	esac
done

if [ "${SAFER_TEST_RT_CMD:+x}" ]; then
	test_runtime="$SAFER_TEST_RT_CMD"
elif [ "${SAFER_RT_CMD:+x}" ]; then
	test_runtime="$SAFER_RT_CMD"
elif command -v podman >/dev/null 2>&1; then
	test_runtime=podman
elif command -v docker >/dev/null 2>&1; then
	test_runtime=docker
fi

# Normalize container runtime for tests
SAFER_RT_CMD=docker
export SAFER_RT_CMD

# Test env
SAFER_DIR=tests/outputs
export SAFER_DIR
SAFER_LIB_PATH=tests/share
export SAFER_LIB_PATH

# Usage text for reference
[ "${verbose:+x}" ] && echo "Grabbing usage text..."
usage=$(./safer -h)

# ---- TEST CASE ----
[ "${verbose:+x}" ] && echo "PATH definition..."
test "PATH=\".safer:\$PATH\"" = "$(unset SAFER_DIR && ./safer)"

# ---- TEST CASE ----
[ "${verbose:+x}" ] && echo "PATH definition with -d override..."
test "PATH=\"tests:\$PATH\"" = "$(./safer -d tests)"

# ---- TEST CASE ----
[ "${verbose:+x}" ] && echo "PATH definition with env override..."
test "PATH=\"tests/outputs:\$PATH\"" = "$(./safer)"

# ---- TEST CASE ----
[ "${verbose:+x}" ] && echo "Illegal option..."
if ./safer -Z >"$actual" 2>"$actual_err"; then
	exit 1
fi
echo "$usage" > "$expected"
diff "$expected" "$actual"
echo "Illegal option -Z" > "$expected_err"
diff "$expected_err" "$actual_err"

# ---- TEST CASE ----
[ "${verbose:+x}" ] && echo "Invalid call not detected by optargs..."
if ./safer only_one_arg >"$actual"; then
	exit 1
fi
echo "$usage" > "$expected"
diff "$expected" "$actual"

# ---- TEST CASE ----
[ "${verbose:+x}" ] && echo "Basic generation..."
./safer basic a_tool_image:latest
sed -i 's|'"$(pwd)"'|CWD|g' tests/outputs/basic
diff tests/refs/basic tests/outputs/basic

# ---- TEST CASE ----
[ "${verbose:+x}" ] && echo "Target other dir and use underscores..."
./safer -d tests/outputs/alt dest a_tool_image:latest
test -e "tests/outputs/alt/dest"

# ---- TEST CASE ----
[ "${verbose:+x}" ] && echo "Don't replace existing scripts..."
touch tests/outputs/existing_basic
if ./safer existing_basic a_tool_image:latest >"$actual"; then
	exit 1
fi
echo "tests/outputs/existing_basic already exists." > "$expected"
diff "$expected" "$actual"

# ---- TEST CASE ----
[ "${verbose:+x}" ] && echo "Do replace existing scripts with -f..."
touch tests/outputs/also_existing_basic
./safer -f also_existing_basic a_tool_image:latest
sed -i 's|'"$(pwd)"'|CWD|g' tests/outputs/also_existing_basic
[ "${verbose:+x}" ] && echo "Generation with port..."
./safer -p 10443 port a_tool_image:latest
sed -i 's|'"$(pwd)"'|CWD|g' tests/outputs/port
diff tests/refs/port tests/outputs/port

# ---- TEST CASE ----
[ "${verbose:+x}" ] && echo "Extra volumes..."
./safer volumes a_tool_image:latest /vol/1 /vol/2
sed -i 's|'"$(pwd)"'|CWD|g' tests/outputs/volumes
diff tests/refs/volumes tests/outputs/volumes

# ---- TEST CASE ----
[ "${verbose:+x}" ] && echo "Custom entrypoint..."
./safer -x /bin/other_bin entrypoint a_tool_image:latest
sed -i 's|'"$(pwd)"'|CWD|g' tests/outputs/entrypoint
diff tests/refs/entrypoint tests/outputs/entrypoint

# ---- TEST CASE ----
[ "${verbose:+x}" ] && echo "STDIN/Pseudo-tty mode: BOTH..."
./safer -t BOTH tty-both a_tool_image:latest
sed -i 's|'"$(pwd)"'|CWD|g' tests/outputs/tty-both
diff tests/refs/tty-both tests/outputs/tty-both

# ---- TEST CASE ----
[ "${verbose:+x}" ] && echo "STDIN/Pseudo-tty mode: STDIN..."
./safer -t STDIN tty-stdin a_tool_image:latest
sed -i 's|'"$(pwd)"'|CWD|g' tests/outputs/tty-stdin
diff tests/refs/tty-stdin tests/outputs/tty-stdin

# ---- TEST CASE ----
[ "${verbose:+x}" ] && echo "STDIN/Pseudo-tty mode: TTY..."
./safer -t TTY tty-tty a_tool_image:latest
sed -i 's|'"$(pwd)"'|CWD|g' tests/outputs/tty-tty
diff tests/refs/tty-tty tests/outputs/tty-tty

# ---- TEST CASE ----
[ "${verbose:+x}" ] && echo "STDIN/Pseudo-tty mode: NONE..."
./safer -t NONE tty-none a_tool_image:latest
sed -i 's|'"$(pwd)"'|CWD|g' tests/outputs/tty-none
diff tests/refs/tty-none tests/outputs/tty-none

# ---- TEST CASE ----
[ "${verbose:+x}" ] && echo "Invalid STDIN/pseudo-tty mode..."
if ./safer -t bogus bad_tty a_tool_image:latest >"$actual"; then
	exit 1
fi
echo "$usage" > "$expected"
diff "$expected" "$actual"

# ---- TEST CASE ----
[ "${verbose:+x}" ] && echo "Library image..."
cat >"$expected" <<EOF
Build script was installed. Review and build with:
cat "tests/outputs/build/build_tool"
(podman|docker) build -t "safer-build_tool:latest" -f "build_tool" "tests/outputs/build"
EOF
./safer -i build_tool >"$actual"
diff tests/share/images/build_tool tests/outputs/build/build_tool
diff "$expected" "$actual"

# ---- TEST CASE ----
[ "${verbose:+x}" ] && echo "Library image and build..."
cat >"$expected" <<EOF
$ echo build -t "safer-build_tool_build:latest" -f "build_tool_build" "tests/outputs/build"
build -t safer-build_tool_build:latest -f build_tool_build tests/outputs/build
EOF
SAFER_RT_CMD="echo" ./safer -I build_tool_build >"$actual"
diff tests/share/images/build_tool_build tests/outputs/build/build_tool_build
diff "$expected" "$actual"

# ---- TEST CASE ----
[ "${verbose:+x}" ] && echo "Missing library image..."
if out=$(./safer -i not_a_lib_image); then
	exit 1
fi
test "$out" = "not_a_lib_image image not found in library."

# ---- TEST CASE ----
[ "${verbose:+x}" ] && echo "Don't replace build file from library..."
touch tests/outputs/build/build_tool_existing
if out=$(./safer -i build_tool_existing); then
	exit 1
fi
test "$out" = "tests/outputs/build/build_tool_existing already exists."

# ---- TEST CASE ----
[ "${verbose:+x}" ] && echo "Do replace build file from library with -f..."
cat >"$expected" <<EOF
Build script was installed. Review and build with:
cat "tests/outputs/build/build_tool_also_existing"
(podman|docker) build -t "safer-build_tool_also_existing:latest" -f "build_tool_also_existing" "tests/outputs/build"
EOF
touch tests/outputs/build/build_tool_also_existing
./safer -f -i build_tool_also_existing >"$actual"
diff tests/share/images/build_tool_also_existing tests/outputs/build/build_tool_also_existing
diff "$expected" "$actual"

# ---- TEST CASE ----
[ "${verbose:+x}" ] && echo "Get the build file from an alternative location..."
cat >"$expected" <<EOF
Build script was installed. Review and build with:
cat "tests/outputs/build/build_tool_alt"
(podman|docker) build -t "safer-build_tool_alt:latest" -f "build_tool_alt" "tests/outputs/build"
EOF
SAFER_LIB_PATH=tests/share:tests/share_alt ./safer -i build_tool_alt >"$actual"
diff tests/share_alt/images/build_tool_alt tests/outputs/build/build_tool_alt
diff "$expected" "$actual"

# ---- TEST CASE ----
[ "${verbose:+x}" ] && echo "Runtime override..."
SAFER_RT_CMD="non-docker" ./safer rt_override a_tool_image:latest
sed -i 's|'"$(pwd)"'|CWD|g' tests/outputs/rt_override
diff tests/refs/rt_override tests/outputs/rt_override

# ---- TEST CASE ----
[ "${verbose:+x}" ] && echo "Runtime and args override (sudo docker + no args)..."
SAFER_RT_CMD="sudo docker" SAFER_RT_ARGS="" ./safer rt_override_sudo_no_args a_tool_image:latest
sed -i 's|'"$(pwd)"'|CWD|g' tests/outputs/rt_override_sudo_no_args
diff tests/refs/rt_override_sudo_no_args tests/outputs/rt_override_sudo_no_args

# Early exit for tests dependant on a container runtime
if [ "${non_rt:+x}" ]; then
	echo "Warning: Partial run. Skipping tests requiring a container runtime."
	rm -f "$expected"
	rm -f "$expected_err"
	rm -f "$actual"
	rm -f "$actual_err"
	exit
fi

# Use tests actual container runtime for tests
SAFER_RT_CMD="$test_runtime"
export SAFER_RT_CMD

# Unrealiable hack: We remove the RT args here and in refs when running
# using podman. Docker test runs are running with overriden args too.
# Should not be a problem unless tests dependant on uid/gid are added
# in the future.
if [ "$test_runtime" = "podman" ]; then
	SAFER_RT_ARGS=""
	export SAFER_RT_ARGS
fi

# Create fake container images
if cd tests/image; then
	$test_runtime build -f Containerfile.no-entrypoint -t safer-test-image-no-entrypoint . >/dev/null
	$test_runtime build -f Containerfile.bin -t safer-test-image-bin . >/dev/null
	$test_runtime build -f Containerfile.sh -t safer-test-image-sh . >/dev/null
	cd - >/dev/null
fi

# ---- TEST CASE ----
[ "${verbose:+x}" ] && echo "Persistent..."
./safer -k persistent safer-test-image-no-entrypoint
sed -i 's|'"$(pwd)"'|CWD|g' tests/outputs/persistent
[ "$test_runtime" = "podman" ] && sed -i 's|podman|docker|g' tests/outputs/persistent
diff tests/refs/persistent tests/outputs/persistent

# ---- TEST CASE ----
[ "${verbose:+x}" ] && echo "Persistent and named..."
./safer -n safer-test-container-named persistent-named safer-test-image-no-entrypoint
sed -i 's|'"$(pwd)"'|CWD|g' tests/outputs/persistent-named
[ "$test_runtime" = "podman" ] && sed -i 's|podman|docker|g' tests/outputs/persistent-named
diff tests/refs/persistent-named tests/outputs/persistent-named

# ---- TEST CASE ----
[ "${verbose:+x}" ] && echo "Persistent and prefixed..."
./safer -N safer-test-container-prefixed persistent-prefixed safer-test-image-no-entrypoint
sed -i 's|'"$(pwd)"'|CWD|g' tests/outputs/persistent-prefixed
[ "$test_runtime" = "podman" ] && sed -i 's|podman|docker|g' tests/outputs/persistent-prefixed
diff tests/refs/persistent-prefixed tests/outputs/persistent-prefixed

# ---- TEST CASE ----
[ "${verbose:+x}" ] && echo "Persistent and custom arg..."
./safer -a "--other-safer-stop" persistent-arg safer-test-image-no-entrypoint
sed -i 's|'"$(pwd)"'|CWD|g' tests/outputs/persistent-arg
[ "$test_runtime" = "podman" ] && sed -i 's|podman|docker|g' tests/outputs/persistent-arg
diff tests/refs/persistent-arg tests/outputs/persistent-arg

# ---- TEST CASE ----
[ "${verbose:+x}" ] && echo "Persistent and simple entrypoint..."
./safer -n safer-test-container-bin persistent-bin safer-test-image-bin
sed -i 's|'"$(pwd)"'|CWD|g' tests/outputs/persistent-bin
[ "$test_runtime" = "podman" ] && sed -i 's|podman|docker|g' tests/outputs/persistent-bin
diff tests/refs/persistent-bin tests/outputs/persistent-bin

# ---- TEST CASE ----
[ "${verbose:+x}" ] && echo "Persistent and sh entrypoint..."
./safer -n safer-test-container-sh persistent-sh safer-test-image-sh
sed -i 's|'"$(pwd)"'|CWD|g' tests/outputs/persistent-sh
[ "$test_runtime" = "podman" ] && sed -i 's|podman|docker|g' tests/outputs/persistent-sh
diff tests/refs/persistent-sh tests/outputs/persistent-sh

# ---- TEST CASE ----
[ "${verbose:+x}" ] && echo "Persistent and sh entrypoint plus most of the flags..."
./safer -p 10443 -x /bin/other_bin -n safer-test-container-complex -t STDIN persistent-complex safer-test-image-sh /vol/1 /vol/2
sed -i 's|'"$(pwd)"'|CWD|g' tests/outputs/persistent-complex
[ "$test_runtime" = "podman" ] && sed -i 's|podman|docker|g' tests/outputs/persistent-complex
diff tests/refs/persistent-complex tests/outputs/persistent-complex

# Cleanup fake container images
$test_runtime rmi safer-test-image-no-entrypoint >/dev/null
$test_runtime rmi safer-test-image-bin >/dev/null
$test_runtime rmi safer-test-image-sh >/dev/null

rm -f "$expected"
rm -f "$expected_err"
rm -f "$actual"
rm -f "$actual_err"
